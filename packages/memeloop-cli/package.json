{
  "name": "memeloop-cli",
  "version": "0.0.1",
  "description": "MemeLoop Node SDK and CLI for standalone or quorum agent compute nodes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "memeloop": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter memeloop build && pnpm exec cucumber-js --config features/cucumber.config.js --exit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@memeloop/libp2p": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/react": "^18.3.28",
    "ai": "^4.0.0",
    "better-sqlite3": "^12.4.5",
    "bonjour-service": "^1.2.0",
    "commander": "^12.0.0",
    "etcd3": "1.1.2",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "memeloop": "workspace:*",
    "noise-handshake": "^4.2.0",
    "puppeteer": "^21.0.0",
    "react": "^18.3.1",
    "sodium-universal": "^4.0.0",
    "tiddlywiki": "^5.3.8",
    "tw5-typed": "^1.1.1",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@types/better-sqlite3": "^7.6.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^2.0.0",
    "ink-testing-library": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
