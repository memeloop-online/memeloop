{
  "name": "memeloop-cli",
  "version": "0.0.0",
  "description": "MemeLoop CLI compute node: register, start, status.",
  "license": "MIT",
  "bin": {
    "memeloop": "./dist/cli.mjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.ts\"",
