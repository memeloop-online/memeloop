{
  "name": "memeloop-cli",
  "version": "0.2.4",
  "description": "MemeLoop Node SDK and CLI for standalone or quorum agent compute nodes.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "memeloop": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/auth.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./terminal": {
      "types": "./dist/terminal.d.ts",
      "import": "./dist/terminal.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:packed-provider": "pnpm build && node scripts/verify-packed-responses-provider.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run src/deviceNetwork/__tests__/ordinaryPeerOrchestration.test.ts src/orchestration/__tests__/remoteOrchestrationHttpHandler.test.ts src/orchestration/__tests__/workerGatewayHttpHandler.test.ts src/runtime/__tests__/nodeRuntime.toolOperation.test.ts src/runtime/__tests__/nodeRuntime.workerGateway.test.ts src/runtime/__tests__/nodeRuntime.workloadExecution.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@memeloop/libp2p": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/react": "^18.3.28",
    "better-sqlite3": "13.0.1",
    "commander": "^12.0.0",
    "etcd3": "1.1.2",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "memeloop": "^0.2.2",
    "proxy-agent": "^8.0.2",
    "puppeteer": "^25.4.0",
    "react": "^18.3.1",
    "tiddlywiki": "^5.3.8",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0",
    "tw5-typed": "^1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
