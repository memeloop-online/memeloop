    "ai": "^4.0.0",
    "better-sqlite3": "^12.4.5",
    "bonjour-service": "^1.2.0",
    "commander": "^12.0.0",
    "faye-websocket": "^0.11.4",
    "ink": "^5.2.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.1.0",
    "memeloop": "workspace:*",
    "memeloop-cli": "link:",
    "noise-handshake": "^4.2.0",
    "puppeteer": "^21.0.0",
    "react": "^18.3.1",
