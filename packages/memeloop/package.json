{
  "name": "memeloop",
  "version": "0.0.0",
  "description": "MemeLoop core runtime: agent framework, storage, sync engine, tools, IM adapter.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/generate-loop-sources.mjs && node scripts/generate-profile-sources.mjs && tsup",
    "build:scripts": "node scripts/generate-loop-sources.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@inrupt/solid-client": "^2.0.0",
    "@libp2p/bootstrap": "^12.0.25",
    "@libp2p/circuit-relay-v2": "^4.2.7",
    "@libp2p/crypto": "^5.0.15",
    "@libp2p/identify": "^4.1.8",
    "@libp2p/interface": "^3.2.4",
    "@libp2p/mdns": "^12.0.25",
    "@libp2p/peer-id": "^6.0.11",
    "@libp2p/ping": "^3.1.7",
    "@libp2p/tcp": "^11.0.22",
    "@libp2p/websockets": "^10.1.15",
    "@multiformats/multiaddr": "^13.0.3",
    "ai": "^4.0.0",
    "it-length-prefixed": "^10.0.1",
    "it-map": "^3.1.0",
    "it-pipe": "^3.0.1",
    "json5": "^2.2.3",
    "libp2p": "^3.3.4",
    "uint8arraylist": "^3.0.2",
    "uint8arrays": "^6.1.1",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/azure": "^4.0.0",
    "@ai-sdk/cohere": "^4.0.0",
    "@ai-sdk/deepseek": "^3.0.0",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/google-vertex": "^5.0.0",
    "@ai-sdk/groq": "^4.0.0",
    "@ai-sdk/mistral": "^4.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "@ai-sdk/perplexity": "^4.0.0",
    "@ai-sdk/togetherai": "^3.0.0",
    "@ai-sdk/xai": "^4.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "noise-handshake": "^4.2.0",
    "sodium-universal": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./loop-api": {
      "types": "./dist/loop-api.d.ts",
      "import": "./dist/loop-api.js",
      "require": "./dist/loop-api.cjs"
    },
    "./llm-providers": {
      "types": "./dist/llm-providers.d.ts",
      "import": "./dist/llm-providers.js",
      "require": "./dist/llm-providers.cjs"
    }
  }
}
