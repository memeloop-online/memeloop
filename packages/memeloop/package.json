{
  "name": "memeloop",
  "version": "0.0.0",
  "description": "MemeLoop core runtime: agent framework, storage, sync engine, tools, IM adapter.",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --sourcemap --external noise-handshake --external sodium-universal",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@inrupt/solid-client": "^2.0.0",
    "json5": "^2.2.3",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.0.0",
    "noise-handshake": "^4.2.0",
    "sodium-universal": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
