{
  "name": "memeloop",
  "version": "0.2.1",
  "description": "MemeLoop core runtime: agent framework, storage, sync engine, tools, IM adapter.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/generate-loop-sources.mjs && node scripts/generate-profile-sources.mjs && tsup",
    "build:scripts": "node scripts/generate-loop-sources.mjs",
    "catalog:sync": "node scripts/sync-model-catalog.mjs",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:boundaries": "node ../../scripts/check-portable-boundaries.mjs --ci"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "ai": "^7.0.37",
    "ajv": "^8.20.0",
    "json5": "^2.2.3",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.24.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.19",
    "@ai-sdk/azure": "^4.0.0",
    "@ai-sdk/cohere": "^4.0.0",
    "@ai-sdk/deepseek": "^3.0.13",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/google-vertex": "^5.0.0",
    "@ai-sdk/groq": "^4.0.0",
    "@ai-sdk/mistral": "^4.0.0",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/perplexity": "^4.0.0",
    "@ai-sdk/togetherai": "^3.0.0",
    "@ai-sdk/xai": "^4.0.0",
    "@inrupt/solid-client": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "ollama-ai-provider-v2": "^4.0.1",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.19",
    "@ai-sdk/azure": "^4.0.0",
    "@ai-sdk/cohere": "^4.0.0",
    "@ai-sdk/deepseek": "^3.0.13",
    "@ai-sdk/google": "^4.0.0",
    "@ai-sdk/google-vertex": "^5.0.0",
    "@ai-sdk/groq": "^4.0.0",
    "@ai-sdk/mistral": "^4.0.0",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@ai-sdk/perplexity": "^4.0.0",
    "@ai-sdk/togetherai": "^3.0.0",
    "@ai-sdk/xai": "^4.0.0",
    "ollama-ai-provider-v2": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/azure": {
      "optional": true
    },
    "@ai-sdk/cohere": {
      "optional": true
    },
    "@ai-sdk/deepseek": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/google-vertex": {
      "optional": true
    },
    "@ai-sdk/groq": {
      "optional": true
    },
    "@ai-sdk/mistral": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@ai-sdk/perplexity": {
      "optional": true
    },
    "@ai-sdk/togetherai": {
      "optional": true
    },
    "@ai-sdk/xai": {
      "optional": true
    },
    "ollama-ai-provider-v2": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "react-native": "./dist/browser.js",
      "browser": "./dist/browser.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./loop-api": {
      "types": "./dist/loop-api.d.ts",
      "import": "./dist/loop-api.js",
      "require": "./dist/loop-api.cjs"
    },
    "./llm-providers": {
      "types": "./dist/llm-providers.d.ts",
      "import": "./dist/llm-providers.js",
      "require": "./dist/llm-providers.cjs"
    },
    "./model-catalog": {
      "types": "./dist/model-catalog.d.ts",
      "import": "./dist/model-catalog.js",
      "require": "./dist/model-catalog.cjs"
    },
    "./conversation": {
      "types": "./dist/conversation.d.ts",
      "import": "./dist/conversation.js",
      "require": "./dist/conversation.cjs"
    },
    "./device-network": {
      "types": "./dist/device-network.d.ts",
      "import": "./dist/device-network.js",
      "require": "./dist/device-network.cjs"
    },
    "./device-network/portable": {
      "types": "./dist/device-network-portable.d.ts",
      "import": "./dist/device-network-portable.js",
      "require": "./dist/device-network-portable.cjs"
    },
    "./orchestration/portable": {
      "types": "./dist/orchestration-portable.d.ts",
      "import": "./dist/orchestration-portable.js",
      "require": "./dist/orchestration-portable.cjs"
    },
    "./mobile": {
      "types": "./dist/mobile.d.ts",
      "import": "./dist/mobile.js",
      "require": "./dist/mobile.cjs"
    },
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  }
}
